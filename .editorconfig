# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,md,sql,js,ts,svelte,css,html,tf,tofu,hcl}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{Makefile,justfile,*.just}]
indent_style = tab

[*.go]
indent_style = tab
