# Copy to .env and fill in local values. Never commit .env.
# Every variable the code reads is listed here with a placeholder.

# --- Source identification (not a secret) --------------------------------
# Rijkswaterstaat asks clients to identify themselves with an optional X-API-KEY header.
# Use a project or application name, never a personal e-mail address.
HELDER_RWS_CLIENT_ID=helder-local-dev
HELDER_HTTP_USER_AGENT=helder/0.0 (+https://github.com/soheil-mp/helder)

# --- Data budget ------------------------------------------------------------
HELDER_DATA_DIR=./data
HELDER_STORAGE_BUDGET_MIB=2048
HELDER_DOWNLOAD_BUDGET_MIB_PER_DAY=200

# --- Local platform (Docker Compose) ---------------------------------------
POSTGRES_USER=helder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=helder
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=helder-lake
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081/apis/ccompat/v7
DAGSTER_HOME=./.dagster

# --- Alerts -------------------------------------------------------------------
NTFY_BASE_URL=http://localhost:8090
NTFY_TOPIC=helder-alerts-local
