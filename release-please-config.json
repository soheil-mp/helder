{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "build",
      "section": "Build system"
    },
    {
      "type": "ci",
      "section": "Continuous integration"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "test",
      "section": "Tests"
    },
    {
      "type": "chore",
      "section": "Maintenance",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "helder",
      "changelog-path": "CHANGELOG.md",
      "release-as": "0.1.0",
      "extra-files": [
        {
          "type": "toml",
          "path": "packages/helder-alerts/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "packages/helder-api/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "packages/helder-cli/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "packages/helder-connectors/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "packages/helder-core/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "packages/helder-lake/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "packages/helder-norms/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "packages/helder-pipelines/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "packages/helder-qc/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "packages/helder-sta/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "packages/helder-stream/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "yaml",
          "path": "CITATION.cff",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
