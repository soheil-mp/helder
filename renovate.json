{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "One pull request for all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "One pull request for all pre-commit hook updates",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "Development tools: grouped, and patch updates merged automatically once CI passes",
      "matchPackageNames": [
        "hypothesis",
        "import-linter",
        "mypy",
        "pre-commit",
        "pytest",
        "pytest-cov",
        "ruff",
        "uv",
        "rust-just"
      ],
      "groupName": "Python development tools"
    },
    {
      "description": "Development tools: automerge patch updates",
      "matchPackageNames": [
        "hypothesis",
        "import-linter",
        "mypy",
        "pre-commit",
        "pytest",
        "pytest-cov",
        "ruff",
        "uv",
        "rust-just"
      ],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Numerical and QC core: reviewed by hand, never automerged, because updates can change flags and numbers (ADR-0012)",
      "matchPackageNames": ["ioos-qc", "gsw", "pint", "numpy", "scipy", "pandas", "polars", "duckdb"],
      "groupName": "Numerical and QC core",
      "automerge": false,
      "labels": ["dependencies", "science"]
    },
    {
      "description": "Platform services move together and are tested end to end",
      "matchDatasources": ["docker"],
      "groupName": "Platform images",
      "automerge": false
    },
    {
      "description": "Hold Python at 3.13 until dagster-dbt supports a newer version (ADR-0017)",
      "matchDepNames": ["python"],
      "allowedVersions": "<3.14"
    }
  ],
  "customManagers": [
    {
      "description": "uv version pinned in CI workflows",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["UV_VERSION: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi"
    },
    {
      "description": "Tool versions pinned in the devcontainer",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/devcontainer\\.json$/"],
      "matchStrings": ["pipx install (?<depName>[a-z0-9-]+)==(?<currentValue>[^ \"]+)"],
      "datasourceTemplate": "pypi"
    },
    {
      "description": "Tool versions pinned in mise.toml",
      "customType": "regex",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": ["(?<depName>uv) = \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "pypi"
    }
  ]
}
