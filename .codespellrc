[codespell]
# Dutch domain vocabulary (Aquo codes, place names, legal terms) is not misspelled English.
skip = *.lock,*.svg,*.json,tests/fixtures/*
ignore-words-list = methode,helder,aquo,ow,te,nd,ser,ue,ist,wil,oder,ans,afvoer,waterschap,waterschappen,meetwaarde,grootheid,eenheid,hoedanigheid,compartiment,parameter,locatie,waarde,mooie,ned,ons,deze,dat,als,omgevingswet,innamepunt,innamepunten,zwemwater,bemonsteringshoogte,opdrachtgevende,instantie,statuswaarde,gecontroleerd,ongecontroleerd,ophalen,waarnemingen,catalogus,kwaliteitswaardecode,rijkswateren,provincie,doorzicht,troebelheid,geleidendheid,chloride,zuurstof,zuurgraad,lek,maas,rijn,waal,ijssel,amer,heel,brakel,andijk,lobith,eijsden,haringvliet,markermeer,kinderdijk,lekkanaal,nieuwegein,bergambacht,scheelhoek,stellendam,vrouw,weer,thru
